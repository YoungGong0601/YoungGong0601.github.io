---
import character from "@/assets/images/character.gif";
import config from "@/config";
import Layout from "@/layouts/Layout.astro";
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = Astro.currentLocale ?? config.site.lang;

const links = [
    {
        label: "Portfolio",
        desc: "만든 게임과 프로젝트",
        href: config.socials.find(s => s.name === "notion")?.url,
    },
    {
        label: "Blog",
        desc: "개발하며 남긴 기록",
        href: getRelativeLocaleUrl(locale, "blog"),
    },
];
---

<Layout>
    <canvas
        id="ascii-light"
        aria-hidden="true"
        class="pointer-events-none fixed inset-0 size-full"></canvas>

    <main
        id="main-content"
        class="landing relative mx-auto flex min-h-dvh w-full max-w-2xl flex-col justify-center px-4 py-16"
    >
        <header class="flex flex-col items-center text-center">
            <img
                src={character.src}
                alt=""
                width={192}
                height={192}
                class="character size-24 object-contain [image-rendering:pixelated]"
            />
            <h1 class="mt-4 text-3xl font-bold">홍령기</h1>
            <p class="text-muted-foreground mt-1 text-sm">
                Unity Client Developer &amp; System Developer
            </p>
        </header>

        <nav class="mt-12 grid grid-cols-2 gap-3 sm:gap-4" aria-label="바로가기">
            {
                links.map(({ label, desc, href }) => {
                    const external = href?.startsWith("http");
                    return (
                        <a
                            href={href}
                            target={external ? "_blank" : null}
                            rel={external ? "noopener noreferrer" : null}
                            class="panel focus-visible:outline-accent flex flex-col p-5 focus-visible:outline-2 focus-visible:outline-offset-2 sm:p-7"
                        >
                            <span class="panel-title text-2xl font-bold tracking-tight sm:text-4xl">
                                {label}
                            </span>
                            <span class="mt-1 text-sm">{desc}</span>
                        </a>
                    );
                })
            }
        </nav>

        <p class="text-muted-foreground mt-10 text-center text-sm">
            Minimal Design, Maximal Fun.
        </p>
    </main>
</Layout>

<script>
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

    const character = document.querySelector<HTMLElement>(".character")!;
    document.querySelectorAll(".panel").forEach(panel =>
        panel.addEventListener("mouseenter", () => {
            if (still) return;
            character.animate(
                [{ translate: "0 0" }, { translate: "0 -6px", offset: 0.4 }, { translate: "0 0" }],
                { duration: 150, easing: "ease-out" }
            );
        })
    );

    const canvas = document.querySelector<HTMLCanvasElement>("#ascii-light")!;
    const ctx = canvas.getContext("2d")!;
    const RAMP = " .:-=+*#%@";
    const CELL = 14;

    function resize() {
        const dpr = devicePixelRatio || 1;
        canvas.width = innerWidth * dpr;
        canvas.height = innerHeight * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.font = `${CELL}px "IBM Plex Mono", ui-monospace, monospace`;
        ctx.textBaseline = "top";
        ctx.globalAlpha = 0.35;
    }

    function hexToRgb(hex: string) {
        const n = parseInt(hex.trim().slice(1), 16);
        return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
    }

    function draw(time: number) {
        const w = innerWidth;
        const h = innerHeight;
        const t = time / 1000;
        const a = { x: w * (0.5 - 0.3 * Math.cos(t * 0.13)), y: h * (0.5 - 0.25 * Math.cos(t * 0.09)) };
        const b = { x: w * (0.5 + 0.3 * Math.cos(t * 0.11)), y: h * (0.5 + 0.25 * Math.cos(t * 0.15)) };
        const radius = Math.max(w, h) * 0.45;
        const glow = (x: number, y: number, l: typeof a) =>
            Math.exp(-2.5 * (Math.hypot(x - l.x, y - l.y) / radius) ** 2);

        const root = document.documentElement;
        const colorA = hexToRgb(getComputedStyle(root).getPropertyValue("--accent"));
        // 개선 필요: 남색도 theme.css 변수로
        const colorB = hexToRgb(root.dataset.theme === "dark" ? "#4a74d4" : "#14357f");

        ctx.clearRect(0, 0, w, h);
        for (let y = 0; y < h; y += CELL) {
            for (let x = 0; x < w; x += CELL * 0.6) {
                const ea = glow(x, y, a);
                const eb = glow(x, y, b);
                const level = Math.floor((1 - Math.exp(-1.6 * (ea + eb))) * RAMP.length);
                if (level <= 0) continue;
                const k = eb / (ea + eb);
                // 개선 필요: 칸마다 색 문자열을 새로 만듦
                ctx.fillStyle = `rgb(${colorA.map((c, i) => c + (colorB[i] - c) * k).join(",")})`;
                ctx.fillText(RAMP[Math.min(level, RAMP.length - 1)], x, y);
            }
        }
    }

    let last = 0;
    function loop(time: number) {
        // 개선 필요: 15fps 고정
        if (time - last >= 66) {
            last = time;
            draw(time);
        }
        requestAnimationFrame(loop);
    }

    resize();
    addEventListener("resize", () => {
        resize();
        draw(last);
    });
    if (still) draw(0);
    else requestAnimationFrame(loop);
</script>

<style>
    .panel {
        transition:
            background-color 200ms,
            translate 200ms;
    }
    .panel:hover,
    .panel:focus-visible {
        translate: 0 -4px;
        background-color: color-mix(in srgb, var(--accent) 8%, transparent);
    }
    .panel:hover .panel-title {
        color: var(--accent);
    }

    .landing:has(.panel:last-child:hover) .character {
        transform: scaleX(-1);
    }

    @media (prefers-reduced-motion: reduce) {
        .panel {
            transition: none;
        }
    }
</style>
