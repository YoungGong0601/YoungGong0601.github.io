---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
import { defaultImage } from "@/utils/defaultImage";
import heroSample from "@/assets/images/home-hero.jpg";
import character from "@/assets/images/character.png";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import Tag from "@/components/Tag.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyStr } from "@/utils/slugify";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const homePath = getRelativeLocaleUrl(locale, "");

// 아래 값들은 모두 실제 글에서 계산한다.
const published = posts.filter(({ data }) => !data.draft);

const tagCount = new Map<string, number>();
for (const { data } of published) {
  for (const tag of data.tags) {
    tagCount.set(tag, (tagCount.get(tag) ?? 0) + 1);
  }
}
const allTags = [...tagCount.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0])
);

const seriesMap = new Map<string, number>();
for (const { data } of published) {
  const name = data.series?.trim();
  if (name) seriesMap.set(name, (seriesMap.get(name) ?? 0) + 1);
}
const seriesList = [...seriesMap.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0])
);

// 좌측 버튼. href 가 없으면 자리만 잡아둔 버튼이다.
const shortcuts = [
  {
    label: "포트폴리오",
    href: "https://younggong0601.notion.site/_-3d895708e15a80648c7bf4d2957ce5f7",
    external: true,
  },
  { label: "준비 중", href: null },
  { label: "준비 중", href: null },
];

const lastUpdated = sortedPosts[0]?.data.pubDatetime;
const lastUpdatedText = lastUpdated
  ? `${lastUpdated.getFullYear()}.${String(lastUpdated.getMonth() + 1).padStart(2, "0")}.${String(lastUpdated.getDate()).padStart(2, "0")}`
  : "";

// 양 옆 레일은 본문(48rem) 바깥 여백에 놓는다.
const railStart = "max(1rem, calc(50vw - 24rem - 15.25rem))";
---

<Layout>
  <Header />

  {/* 좌측 레일: 시리즈와 글 목록 */}
  <aside
    class="fixed top-32 bottom-10 hidden w-52 overflow-y-auto xl:block"
    style={`inset-inline-start: ${railStart}`}
    aria-label="Series, DEVLOG"
  >
    {
      seriesList.length > 0 && (
        <section class="mb-8">
          <p class="text-muted-foreground mb-3 text-xs">Series</p>
          <ul class="flex flex-col gap-2.5 text-sm">
            {seriesList.map(([name, count]) => (
              <li>
                <a
                  href={getRelativeLocaleUrl(
                    locale,
                    `series/${slugifyStr(name)}`
                  )}
                  class="hover:text-accent flex items-baseline justify-between gap-3 leading-snug"
                >
                  <span class="font-medium">{name}</span>
                  <span class="text-muted-foreground text-xs">{count}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section>
      <p class="text-muted-foreground mb-3 text-xs">DEVLOG</p>
      <ul class="flex flex-col gap-3">
        {
          sortedPosts.map(entry => (
            <li>
              <a
                href={getPostUrl(entry.id, entry.filePath, Astro.currentLocale)}
                class="text-muted-foreground hover:text-accent grid grid-cols-[2.5rem_1fr] items-center gap-2.5 text-sm leading-snug"
              >
                <Image
                  src={entry.data.heroImage ?? defaultImage(entry.id)}
                  alt=""
                  width={64}
                  height={64}
                  quality={45}
                  loading="lazy"
                  decoding="async"
                  class="aspect-square w-full rounded-md object-cover"
                />
                <span>{entry.data.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </aside>

  {/* 우측 레일: 버튼과 전체 태그 */}
  <aside
    class="fixed top-32 bottom-10 hidden w-52 overflow-y-auto xl:block"
    style={`inset-inline-end: ${railStart}`}
    aria-label="바로가기와 태그"
  >
    <ul class="flex flex-col gap-2">
      {
        shortcuts.map(item =>
          item.href ? (
            <li>
              <a
                href={item.href}
                target={item.external ? "_blank" : null}
                rel={item.external ? "noopener" : null}
                class="border-border hover:border-accent hover:text-accent block border px-3 py-2 text-sm transition-colors duration-300"
              >
                {item.label}
              </a>
            </li>
          ) : (
            <li>
              <span class="border-border text-muted-foreground block cursor-default border border-dashed px-3 py-2 text-sm">
                {item.label}
              </span>
            </li>
          )
        )
      }
    </ul>

    {
      allTags.length > 0 && (
        <section class="mt-8">
          <p class="text-muted-foreground mb-3 text-xs">Tags</p>
          <ul class="flex flex-wrap items-start gap-x-4 gap-y-2.5">
            {allTags.map(([tag]) => (
              <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />
            ))}
          </ul>
        </section>
      )
    }
  </aside>

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    {/* 상단 히어로 이미지 (샘플). heroSample 만 바꾸면 된다. */}
    <Image
      src={heroSample}
      alt=""
      width={1600}
      height={500}
      class="mt-8 aspect-16/5 w-full rounded-xl object-cover"
    />

    <section id="hero" class="border-border border-b pt-10 pb-10">
      <div class="flex items-center gap-4">
        {/* 픽셀 아트라 확대해도 뭉개지지 않게 렌더링을 지정한다 */}
        <Image
          src={character}
          alt=""
          width={160}
          height={160}
          class="size-16 shrink-0 [image-rendering:pixelated]"
        />
        <div>
          <p class="text-muted-foreground text-sm">
            Unity Client Developer &amp; System Developer
          </p>
          <h1 class="mt-1 text-4xl font-semibold sm:text-5xl">홍령기</h1>
        </div>
      </div>

      <p class="mt-4 max-w-prose leading-relaxed">
        읽고 만든 것을 기록합니다. 옵시디언으로 쓰고 여기에 쌓습니다. 시스템을
        설계하고 확장성과 유연성을 목표로 두는 개발을 좋아합니다.
      </p>

      <dl
        class="text-muted-foreground mt-6 flex flex-wrap gap-x-8 gap-y-2 text-sm"
      >
        <div class="flex gap-2">
          <dt>글</dt>
          <dd class="text-foreground font-semibold">{published.length}편</dd>
        </div>
        <div class="flex gap-2">
          <dt>태그</dt>
          <dd class="text-foreground font-semibold">{tagCount.size}개</dd>
        </div>
        {
          lastUpdatedText && (
            <div class="flex gap-2">
              <dt>최근 글</dt>
              <dd class="text-foreground font-semibold">{lastUpdatedText}</dd>
            </div>
          )
        }
      </dl>

      <div class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-2">
        {socials.length > 0 && <Socials />}
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="pt-10 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul class="grid gap-x-6 sm:grid-cols-2">
            {featuredPosts.map(data => (
              <Card variant="h3" pinnedStyle {...data} />
            ))}
          </ul>
        </section>
      )
    }
  </main>

  <Footer />
</Layout>
