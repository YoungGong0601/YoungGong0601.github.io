---
import character from "@/assets/images/character.png";
import heroSample from "@/assets/images/home-hero.jpg";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import PostList from "@/components/PostList.astro";
import Rail from "@/components/Rail.astro";
import Socials from "@/components/Socials.astro";
import FilterList from "@/components/FilterList.astro";
import config from "@/config";
import { useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getSeries, getTags } from "@/utils/taxonomy";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const homePath = getRelativeLocaleUrl(locale, "");

// 아래 값들은 모두 실제 글에서 계산한다.
const published = posts.filter(({ data }) => !data.draft);

const allTags = getTags(posts);
const seriesList = getSeries(posts);

// 좌측 버튼. href 가 없으면 자리만 잡아둔 버튼이다.
const shortcuts = [
    {
        label: "포트폴리오",
        href: "https://younggong0601.notion.site/_-3d895708e15a80648c7bf4d2957ce5f7",
        external: true,
        primary: false,
    },
    // primary 는 강조색으로 채운다. 이 사이트의 본진이라 눈에 먼저 들어와야 한다.
    {
        label: "DEVLOG",
        href: getRelativeLocaleUrl(locale, "posts"),
        external: false,
        primary: true,
    },
    // { label: "준비 중", href: null },
    // { label: "준비 중", href: null },
];

const lastUpdated = sortedPosts[0]?.data.pubDatetime;
const lastUpdatedText = lastUpdated
    ? `${lastUpdated.getFullYear()}.${String(lastUpdated.getMonth() + 1).padStart(2, "0")}.${String(lastUpdated.getDate()).padStart(2, "0")}`
    : "";
---

<Layout kind="list">
    <Header />

    {/* 좌측 레일: 글 목록 */}
    <Rail side="start" label="DEVLOG">
        <section class="relative flex h-full flex-col">
            <p class="text-muted-foreground mb-3 shrink-0 text-xs">DEVLOG</p>
            <div class="scroll-box min-h-0 flex-1 pb-4 pe-3">
                <PostList posts={sortedPosts} />
            </div>
        </section>
    </Rail>

    {/* 우측 레일: 시리즈와 태그 */}
    <Rail side="end" label="Series, Tags">
        <div class="flex h-full flex-col">
            {
                seriesList.length > 0 && (
                    <section class="shrink-0">
                        <p class="text-muted-foreground mb-3 text-xs">Series</p>
                        <FilterList
                            kind="series"
                            items={seriesList}
                            mode="link"
                        />
                    </section>
                )
            }

            {
                allTags.length > 0 && (
                    <section class="relative mt-8 flex min-h-0 flex-1 flex-col">
                        <p class="text-muted-foreground mb-3 shrink-0 text-xs">
                            Tags
                        </p>
                        <div class="scroll-box min-h-0 flex-1 pb-4 pe-3">
                            <FilterList
                                kind="tag"
                                items={allTags}
                                mode="link"
                            />
                        </div>
                    </section>
                )
            }
        </div>
    </Rail>

    <main
        id="main-content"
        data-layout="index"
        data-home-path={homePath}
        class="app-layout my-1"
    >
        {/* 상단 히어로 이미지 (샘플). heroSample 만 바꾸면 된다. */}
        <Image
            src={heroSample}
            alt=""
            width={1600}
            height={500}
            class="mt-3 aspect-16/5 w-full rounded-xl object-cover"
        />

        <section id="hero" class="border-border border-b pt-10 pb-10">
            <div class="flex items-center gap-5">
                {/* 픽셀 아트라 확대해도 뭉개지지 않게 렌더링을 지정한다 */}
                <Image
                    src={character}
                    alt=""
                    width={160}
                    height={160}
                    class="border-border size-20 shrink-0 rounded-full border object-contain [image-rendering:pixelated]"
                />
                <div>
                    <h1 class="text-4xl font-semibold sm:text-5xl">홍령기</h1>
                    <p class="text-muted-foreground mt-1 text-sm">
                        Unity Client Developer &amp; System Developer
                    </p>
                </div>
            </div>

            <p class="mt-5 text-xl sm:text-2xl">Minimal Design, Maximal Fun.</p>

            <p class="mt-3 max-w-prose leading-relaxed">
                안녕하세요. 저는 Unity 기반의 클라이언트 개발과 시스템 개발을
                주로 하는 개발자입니다.
            </p>
            <p class="mt-1 max-w-prose leading-relaxed">
                시스템을 설계하고 확장성과 유연성을 목표로 두는 개발을
                지향합니다.
            </p>

            <dl
                class="text-muted-foreground mt-6 flex flex-wrap gap-x-8 gap-y-2 text-sm"
            >
                <div class="flex gap-2">
                    <dt>글</dt>
                    <dd class="text-foreground font-semibold">
                        {published.length}편
                    </dd>
                </div>
                <div class="flex gap-2">
                    <dt>태그</dt>
                    <dd class="text-foreground font-semibold">
                        {allTags.length}개
                    </dd>
                </div>
                {
                    lastUpdatedText && (
                        <div class="flex gap-2">
                            <dt>최근 글</dt>
                            <dd class="text-foreground font-semibold">
                                {lastUpdatedText}
                            </dd>
                        </div>
                    )
                }
            </dl>

            <div class="mt-7 grid grid-cols-2 gap-3">
                {
                    shortcuts.map(item =>
                        item.href ? (
                            <a
                                href={item.href}
                                target={item.external ? "_blank" : null}
                                rel={item.external ? "noopener noreferrer" : null}
                                class:list={[
                                    "group flex items-center justify-center gap-1.5 border px-4 py-2 text-center text-sm transition-colors duration-300",
                                    item.primary
                                        ? "border-accent bg-accent text-accent-foreground hover:text-accent font-medium tracking-wide hover:bg-transparent"
                                        : "border-border hover:border-accent hover:text-accent",
                                ]}
                            >
                                {item.label}
                                {item.primary && (
                                    <span
                                        aria-hidden="true"
                                        class="transition-transform duration-300 group-hover:translate-x-1"
                                    >
                                        →
                                    </span>
                                )}
                            </a>
                        ) : (
                            <span class="border-border text-muted-foreground cursor-default border border-dashed px-4 py-2 text-center text-sm">
                                {item.label}
                            </span>
                        )
                    )
                }
            </div>

            <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2">
                {socials.length > 0 && <Socials />}
            </div>
        </section>

        {
            featuredPosts.length > 0 && (
                <section id="featured" class="pt-10 pb-6">
                    <h2 class="text-2xl font-semibold tracking-wide">
                        {t.home.featured}
                    </h2>
                    <ul class="grid gap-x-6 sm:grid-cols-2">
                        {featuredPosts.map((data) => (
                            <Card variant="h3" pinnedStyle {...data} />
                        ))}
                    </ul>
                </section>
            )
        }
    </main>

    <Footer />
</Layout>
