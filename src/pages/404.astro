---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.notFound.title} | ${config.site.title}`}>
  <Header />

  <main
    id="main-content"
    class="app-layout my-1 flex flex-1 items-center justify-center"
  >
    <h1 class="mb-14 text-7xl font-semibold sm:text-8xl">404</h1>
  </main>

  <Footer />
</Layout>
