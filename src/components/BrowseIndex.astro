---
// 시리즈와 태그를 한 화면에서 훑는다. /series 와 /tags 가 같이 쓴다.
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
import Datetime from "@/components/Datetime.astro";
import Tag from "@/components/Tag.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { defaultImage } from "@/utils/defaultImage";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

const posts = await getCollection("posts", ({ data }) => !data.draft);

// 시리즈별로 묶고, 각 시리즈 안에서는 오래된 글부터 읽는 순서로 둔다.
const grouped = new Map<string, typeof posts>();
for (const post of posts) {
  const name = post.data.series?.trim();
  if (!name) continue;
  grouped.set(name, [...(grouped.get(name) ?? []), post]);
}

const series = [...grouped.entries()]
  .map(([name, items]) => ({ name, posts: getSortedPosts(items).reverse() }))
  .sort(
    (a, b) => b.posts.length - a.posts.length || a.name.localeCompare(b.name)
  );

const tagCount = new Map<string, number>();
for (const { data } of posts) {
  for (const tag of data.tags) {
    tagCount.set(tag, (tagCount.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCount.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0])
);
---

<section>
  <h2 class="text-2xl font-semibold tracking-wide">Series</h2>

  {
    series.length === 0 ? (
      <p class="text-muted-foreground mt-4">
        아직 시리즈가 없습니다. 글 frontmatter 에 series 를 넣으면 여기 모입니다.
      </p>
    ) : (
      <div class="mt-6 flex flex-col gap-12">
        {series.map(item => (
          <div>
            <div class="border-border flex items-baseline justify-between gap-4 border-b pb-2">
              <h3 class="text-xl font-semibold">
                <a
                  href={getRelativeLocaleUrl(
                    locale,
                    `series/${slugifyStr(item.name)}`
                  )}
                  class="hover:text-accent"
                >
                  {item.name}
                </a>
              </h3>
              <span class="text-muted-foreground text-sm">
                {item.posts.length}편
              </span>
            </div>

            <ol class="mt-4 flex flex-col gap-4">
              {item.posts.map((post, index) => (
                <li>
                  <a
                    href={getPostUrl(post.id, post.filePath, locale)}
                    class="group grid grid-cols-[2rem_3.5rem_1fr] items-center gap-3"
                  >
                    <span class="text-muted-foreground text-sm tabular-nums">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <Image
                      src={post.data.heroImage ?? defaultImage(post.id)}
                      alt=""
                      width={112}
                      height={112}
                      quality={55}
                      loading="lazy"
                      class="aspect-square w-full rounded-md object-cover"
                    />
                    <span>
                      <span class="group-hover:text-accent block font-medium">
                        {post.data.title}
                      </span>
                      <Datetime
                        pubDatetime={post.data.pubDatetime}
                        modDatetime={post.data.modDatetime}
                        timezone={post.data.timezone}
                      />
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    )
  }
</section>

<section class="border-border mt-16 border-t pt-10">
  <h2 class="text-2xl font-semibold tracking-wide">Tags</h2>

  {
    tags.length === 0 ? (
      <p class="text-muted-foreground mt-4">아직 태그가 없습니다.</p>
    ) : (
      <ul class="mt-6 flex flex-wrap gap-x-8 gap-y-4">
        {tags.map(([tag]) => (
          <Tag tag={slugifyStr(tag)} tagName={tag} />
        ))}
      </ul>
    )
  }
</section>
