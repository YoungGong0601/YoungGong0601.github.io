---
// 본문 옆에 붙는 고정 레일. 홈과 DEVLOG 가 같은 위치를 쓴다.
// 공간은 본문, 좌측 레일, 우측 레일 순으로 나눠 갖는다 (규칙은 global.css).
type Props = {
  side: "start" | "end";
  label: string;
};

const { side, label } = Astro.props;

// 11rem(레일 폭) + 2.25rem(본문과의 간격)
const railStart = "max(1rem, calc(50vw - 24rem - 13.25rem))";
const position =
  side === "start"
    ? `inset-inline-start: ${railStart}`
    : `inset-inline-end: ${railStart}`;
---

<aside
  class:list={[
    "rail fixed top-32 bottom-10 w-44 overflow-hidden overscroll-contain",
    side === "start" ? "rail-start" : "rail-end",
  ]}
  style={position}
  aria-label={label}
>
  <slot />
</aside>
