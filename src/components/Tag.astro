---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tagName: string;
  size?: "sm" | "lg";
  /** true 면 링크 대신 필터 버튼으로 그린다. 모양은 그대로 둔다. */
  filter?: boolean;
};

const { tagName, size = "lg", filter = false } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;

// 링크든 버튼이든 모양은 한 곳에서 관리한다.
const shape = [
  "inline-flex items-center gap-0.5",
  "border-foreground border-b-2",
  "hover:border-accent hover:text-accent hover:-translate-y-0.5",
  "focus-visible:text-accent focus-visible:border-none",
  "aria-pressed:border-accent aria-pressed:text-accent aria-pressed:font-semibold",
  size === "sm" ? "text-sm" : "text-lg",
];

const icon = ["opacity-80", size === "sm" ? "size-4" : "size-5"];
---

<li>
  {
    filter ? (
      <button
        type="button"
        data-filter-tag={tagName}
        aria-pressed={false}
        class:list={shape}
      >
        <IconHash class:list={icon} />
        {tagName}
      </button>
    ) : (
      <a
        href={`${getRelativeLocaleUrl(locale, "posts")}?tag=${encodeURIComponent(tagName)}`}
        class:list={shape}
      >
        <IconHash class:list={icon} />
        {tagName}
      </a>
    )
  }
</li>
