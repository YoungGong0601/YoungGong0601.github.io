---
// 글 목록을 보여주는 유일한 화면.
// /posts, /tags/<태그>, /series/<이름> 이 모두 이 컴포넌트를 쓴다.
// 태그와 시리즈는 어디서 누르든 여기서 목록을 좁히는 것으로 끝난다.
import type { CollectionEntry } from "astro:content";
import Main from "./Main.astro";
import Card from "./Card.astro";
import Rail from "./Rail.astro";
import FilterList from "./FilterList.astro";
import IconLayoutCards from "@/assets/icons/IconLayoutCards.svg";
import IconLayoutList from "@/assets/icons/IconLayoutList.svg";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getTags, getSeries } from "@/utils/taxonomy";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  posts: CollectionEntry<"posts">[];
};

const { posts } = Astro.props;

const t = useTranslations(Astro.currentLocale ?? config.site.lang);

// ponytail: 필터가 클라이언트에서 도니 한 장에 전부 그린다.
// 글이 수십 편을 넘어 첫 화면이 무거워지면 그때 무한 스크롤을 붙인다.
const sorted = getSortedPosts(posts);

const tags = getTags(posts);
const series = getSeries(posts);

---

{/* 좁히는 수단은 한쪽에 모아 둔다. 시리즈가 위, 태그가 아래. */}
{
  (series.length > 0 || tags.length > 0) && (
    <Rail side="start" label="Series, Tags">
      {/* 시리즈는 늘 보이게 두고, 길어지는 태그만 안에서 스크롤한다 */}
      <div class="flex h-full flex-col">
        {series.length > 0 && (
          <section class="mb-8 shrink-0">
            <p class="text-muted-foreground mb-3 text-xs">Series</p>
            <FilterList kind="series" items={series} />
          </section>
        )}
        {tags.length > 0 && (
          <section class="relative flex min-h-0 flex-1 flex-col">
            <p class="text-muted-foreground mb-3 shrink-0 text-xs">Tags</p>
            <div class="scroll-box min-h-0 flex-1 pb-4 pe-3">
              <FilterList kind="tag" items={tags} />
            </div>
          </section>
        )}
      </div>
    </Rail>
  )
}

<Main pageTitle={t.pages.postsTitle} pageDesc={t.pages.postsDesc}>
  <span
    slot="title-extra"
    data-filter-label
    class="text-muted-foreground font-normal"
  />

  <div
    slot="actions"
    class="flex items-center gap-1"
    role="group"
    aria-label="목록 보기 방식"
  >
    <button
      type="button"
      data-view-btn="cards"
      aria-pressed="true"
      title="이미지가 있는 목록"
      aria-label="이미지가 있는 목록"
      class="text-muted-foreground hover:text-accent aria-pressed:text-accent p-1.5"
    >
      <IconLayoutCards class="size-5" />
    </button>
    <button
      type="button"
      data-view-btn="compact"
      aria-pressed="false"
      title="좁은 목록"
      aria-label="좁은 목록"
      class="text-muted-foreground hover:text-accent aria-pressed:text-accent p-1.5"
    >
      <IconLayoutList class="size-5" />
    </button>
  </div>

  {/* 레일이 사라지는 폭에서는 같은 목록을 본문 위에 접어둔다 */}
  {
    (series.length > 0 || tags.length > 0) && (
      <div class="rail-alt border-border mb-8 rounded-lg border px-4 py-3">
        {series.length > 0 && (
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
            <span class="text-muted-foreground w-12 shrink-0 text-xs">
              Series
            </span>
            <FilterList kind="series" items={series} inline />
          </div>
        )}
        {tags.length > 0 && (
          <div
            class:list={[
              "flex flex-wrap items-center gap-x-4 gap-y-2",
              series.length > 0 && "mt-2",
            ]}
          >
            <span class="text-muted-foreground w-12 shrink-0 text-xs">Tags</span>
            <FilterList kind="tag" items={tags} inline />
          </div>
        )}
      </div>
    )
  }

  <ul data-post-list data-view="cards">
    {sorted.map(data => <Card {...data} />)}
  </ul>
</Main>

<script>
  // 움직임을 줄이겠다는 설정은 한 번만 물어본다
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

  // 글로 이동할 때와 같은 화면 전환을 쓴다
  function withTransition(change: () => void) {
    if (!document.startViewTransition || reduced.matches) {
      change();
      return;
    }
    document.startViewTransition(change);
  }

  document.addEventListener("astro:page-load", () => {
    const list = document.querySelector<HTMLElement>("[data-post-list]");
    if (!list) return;

    // ── 목록을 태그와 시리즈로 좁힌다 ──
    // 같은 것을 다시 누르면 풀린다. 종류별로 하나씩 고를 수 있고,
    // 둘 다 고르면 둘 다 만족하는 글만 남는다.
    const items = [...list.querySelectorAll<HTMLElement>("li[data-tags]")];
    const label = document.querySelector<HTMLElement>("[data-filter-label]");

    // 글의 태그는 바뀌지 않는다. 누를 때마다 다시 쪼개지 않는다.
    const tagsOf = new Map(
      items.map(item => [item, (item.dataset.tags ?? "").split("|")])
    );

    const tagButtons = [
      ...document.querySelectorAll<HTMLButtonElement>("[data-filter-tag]"),
    ];
    const seriesButtons = [
      ...document.querySelectorAll<HTMLButtonElement>("[data-filter-series]"),
    ];

    // 좁힌 상태는 주소에 남는다. /posts?series=...&tag=... 하나로 끝낸다.
    const params = new URLSearchParams(location.search);
    let activeTag = params.get("tag") ?? "";
    let activeSeries = params.get("series") ?? "";

    const syncUrl = () => {
      const next = new URLSearchParams();
      if (activeSeries) next.set("series", activeSeries);
      if (activeTag) next.set("tag", activeTag);
      const query = next.toString();
      history.replaceState(
        history.state,
        "",
        query ? `${location.pathname}?${query}` : location.pathname
      );
    };

    const update = () => {
      for (const item of items) {
        const tags = tagsOf.get(item) ?? [];
        item.hidden =
          (activeTag !== "" && !tags.includes(activeTag)) ||
          (activeSeries !== "" && item.dataset.series !== activeSeries);
      }

      // 시리즈는 오래된 글부터 읽는 편이 자연스럽다.
      // 순서가 이미 맞으면 건드리지 않는다. 재배치는 스크롤 위치를 흔든다.
      const ordered = activeSeries ? [...items].reverse() : items;
      const current = [...list.children];
      if (ordered.some((item, index) => current[index] !== item)) {
        for (const item of ordered) list.append(item);
      }

      for (const button of tagButtons) {
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.filterTag === activeTag)
        );
      }
      for (const button of seriesButtons) {
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.filterSeries === activeSeries)
        );
      }

      if (label) {
        // 둘 다 골랐으면 둘 다 보여준다. 시리즈가 먼저다.
        const parts = [activeSeries, activeTag].filter(Boolean);
        label.textContent = parts.length ? ` / ${parts.join(" / ")}` : "";
      }
    };

    const pick = (button: HTMLButtonElement, kind: "tag" | "series") => {
      const name =
        (kind === "tag"
          ? button.dataset.filterTag
          : button.dataset.filterSeries) ?? "";
      if (kind === "tag") activeTag = activeTag === name ? "" : name;
      else activeSeries = activeSeries === name ? "" : name;

      withTransition(update);
      syncUrl();
    };

    for (const button of tagButtons) {
      button.addEventListener("click", () => pick(button, "tag"));
    }
    for (const button of seriesButtons) {
      button.addEventListener("click", () => pick(button, "series"));
    }

    // 주소에 담겨 온 상태를 화면에 맞춘다
    update();

    // ── 카드로 볼지 좁은 줄로 볼지 ──
    // 고른 값은 기기에 남긴다.
    const VIEW_KEY = "postListView";
    const viewButtons = [
      ...document.querySelectorAll<HTMLButtonElement>("[data-view-btn]"),
    ];

    const setView = (view: string) => {
      list.dataset.view = view;
      for (const button of viewButtons) {
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.viewBtn === view)
        );
      }
    };

    try {
      if (localStorage.getItem(VIEW_KEY) === "compact") setView("compact");
    } catch {}

    for (const button of viewButtons) {
      button.addEventListener("click", () => {
        const view = button.dataset.viewBtn ?? "cards";
        try {
          localStorage.setItem(VIEW_KEY, view);
        } catch {}
        withTransition(() => setView(view));
      });
    }
  });
</script>
