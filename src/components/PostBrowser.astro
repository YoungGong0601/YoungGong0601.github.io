---
// 글 목록을 보여주는 유일한 화면.
// /posts, /tags/<태그>, /series/<이름> 이 모두 이 컴포넌트를 쓴다.
// 태그와 시리즈는 어디서 누르든 여기서 목록을 좁히는 것으로 끝난다.
import type { CollectionEntry } from "astro:content";
import Main from "./Main.astro";
import Card from "./Card.astro";
import Rail from "./Rail.astro";
import FilterList from "./FilterList.astro";
import IconLayoutCards from "@/assets/icons/IconLayoutCards.svg";
import IconLayoutList from "@/assets/icons/IconLayoutList.svg";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getTags, getSeries } from "@/utils/taxonomy";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  posts: CollectionEntry<"posts">[];
  /** 처음부터 좁혀둘 태그 이름 */
  activeTag?: string;
  /** 처음부터 좁혀둘 시리즈 이름 */
  activeSeries?: string;
};

const { posts, activeTag, activeSeries } = Astro.props;

const t = useTranslations(Astro.currentLocale ?? config.site.lang);

// ponytail: 필터가 클라이언트에서 도니 한 장에 전부 그린다.
// 글이 수십 편을 넘어 첫 화면이 무거워지면 그때 무한 스크롤을 붙인다.
const sorted = getSortedPosts(posts);

const tags = getTags(posts);
const series = getSeries(posts);

const activeLabel = activeTag ?? activeSeries ?? "";
---

{
  series.length > 0 && (
    <Rail side="start" label="Series">
      <p class="text-muted-foreground mb-3 text-xs">Series</p>
      <FilterList kind="series" items={series} active={activeSeries} />
    </Rail>
  )
}

{
  tags.length > 0 && (
    <Rail side="end" label="Tags">
      <p class="text-muted-foreground mb-3 text-xs">Tags</p>
      <FilterList kind="tag" items={tags} active={activeTag} />
    </Rail>
  )
}

<Main pageTitle={t.pages.postsTitle} pageDesc={t.pages.postsDesc}>
  <span
    slot="title-extra"
    data-filter-label
    class="text-muted-foreground font-normal"
  >
    {activeLabel && ` / ${activeLabel}`}
  </span>

  <div
    slot="actions"
    class="flex items-center gap-1"
    role="group"
    aria-label="목록 보기 방식"
  >
    <button
      type="button"
      data-view-btn="cards"
      aria-pressed="true"
      title="이미지가 있는 목록"
      aria-label="이미지가 있는 목록"
      class="text-muted-foreground hover:text-accent aria-pressed:text-accent p-1.5"
    >
      <IconLayoutCards class="size-5" />
    </button>
    <button
      type="button"
      data-view-btn="compact"
      aria-pressed="false"
      title="좁은 목록"
      aria-label="좁은 목록"
      class="text-muted-foreground hover:text-accent aria-pressed:text-accent p-1.5"
    >
      <IconLayoutList class="size-5" />
    </button>
  </div>

  {/* 레일이 사라지는 폭에서는 같은 목록을 본문 위에 접어둔다 */}
  {
    (series.length > 0 || tags.length > 0) && (
      <details class="border-border mb-8 border-b pb-4 xl:hidden">
        <summary class="text-muted-foreground hover:text-accent cursor-pointer text-sm">
          Series &amp; Tags
        </summary>
        <div class="mt-5 flex flex-col gap-6">
          {series.length > 0 && (
            <div>
              <p class="text-muted-foreground mb-3 text-xs">Series</p>
              <FilterList kind="series" items={series} active={activeSeries} />
            </div>
          )}
          {tags.length > 0 && (
            <div>
              <p class="text-muted-foreground mb-3 text-xs">Tags</p>
              <FilterList kind="tag" items={tags} active={activeTag} />
            </div>
          )}
        </div>
      </details>
    )
  }

  <ul
    data-post-list
    data-view="cards"
    data-initial-tag={activeTag}
    data-initial-series={activeSeries}
  >
    {sorted.map(data => <Card {...data} />)}
  </ul>
</Main>

<script>
  // 목록을 태그와 시리즈로 좁힌다. 같은 것을 다시 누르면 풀린다.
  // 종류별로 하나씩 고를 수 있고, 둘 다 고르면 둘 다 만족하는 글만 남는다.
  document.addEventListener("astro:page-load", () => {
    const list = document.querySelector<HTMLElement>("[data-post-list]");
    if (!list) return;

    const items = [...list.querySelectorAll<HTMLElement>("li[data-tags]")];
    const heading = document.querySelector("#main-content h1");
    const label = heading?.querySelector<HTMLElement>("[data-filter-label]");

    let activeTag = list.dataset.initialTag ?? "";
    let activeSeries = list.dataset.initialSeries ?? "";

    const buttons = (kind: "tag" | "series") => [
      ...document.querySelectorAll<HTMLButtonElement>(`[data-filter-${kind}]`),
    ];

    const update = () => {
      for (const item of items) {
        const tags = (item.dataset.tags ?? "").split("|").filter(Boolean);
        item.hidden =
          (activeTag !== "" && !tags.includes(activeTag)) ||
          (activeSeries !== "" && item.dataset.series !== activeSeries);
      }

      // 시리즈는 오래된 글부터 읽는 편이 자연스럽다
      const ordered = activeSeries ? [...items].reverse() : items;
      for (const item of ordered) list.append(item);

      for (const button of buttons("tag")) {
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.filterTag === activeTag)
        );
      }
      for (const button of buttons("series")) {
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.filterSeries === activeSeries)
        );
      }

      if (label) {
        // 둘 다 골랐으면 둘 다 보여준다. 시리즈가 먼저다.
        const parts = [activeSeries, activeTag].filter(Boolean);
        label.textContent = parts.length ? ` / ${parts.join(" / ")}` : "";
      }
    };

    // 글로 이동할 때와 같은 화면 전환을 쓴다
    const apply = () => {
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
      if (!document.startViewTransition || reduced.matches) {
        update();
        return;
      }
      document.startViewTransition(update);
    };

    for (const button of buttons("tag")) {
      button.addEventListener("click", () => {
        const tag = button.dataset.filterTag ?? "";
        activeTag = activeTag === tag ? "" : tag;
        apply();
      });
    }

    for (const button of buttons("series")) {
      button.addEventListener("click", () => {
        const name = button.dataset.filterSeries ?? "";
        activeSeries = activeSeries === name ? "" : name;
        apply();
      });
    }

    // 좁혀진 주소로 들어온 경우 순서와 표시를 맞춰 둔다
    if (activeTag || activeSeries) update();
  });

  // 목록을 카드로 볼지 좁은 줄로 볼지. 고른 값은 기기에 남긴다.
  const VIEW_KEY = "postListView";

  document.addEventListener("astro:page-load", () => {
    const list = document.querySelector<HTMLElement>("[data-post-list]");
    if (!list) return;

    const buttons = [
      ...document.querySelectorAll<HTMLButtonElement>("[data-view-btn]"),
    ];

    const setView = (view: string) => {
      list.dataset.view = view;
      for (const button of buttons) {
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.viewBtn === view)
        );
      }
    };

    try {
      const saved = localStorage.getItem(VIEW_KEY);
      if (saved === "compact") setView(saved);
    } catch {}

    for (const button of buttons) {
      button.addEventListener("click", () => {
        const view = button.dataset.viewBtn ?? "cards";
        try {
          localStorage.setItem(VIEW_KEY, view);
        } catch {}

        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
        if (!document.startViewTransition || reduced.matches) {
          setView(view);
          return;
        }
        document.startViewTransition(() => setView(view));
      });
    }
  });
</script>
