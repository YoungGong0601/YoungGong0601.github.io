---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();
---

<footer
  class:list={[
    "border-border border-t",
    { "mt-auto": !noMarginTop },
    className,
  ]}
  {...attrs}
>
  <div
    class="app-layout flex flex-col items-center justify-between py-6 sm:flex-row-reverse sm:py-4"
  >
    <Socials />
    <div
      class="my-2 flex flex-col items-center whitespace-nowrap sm:items-start"
    >
      <span>홍령기 | Hong Ryoung Gi</span>
      <span>
        {t.footer.copyright} &#169; {currentYear} {t.footer.allRightsReserved}
      </span>
    </div>
  </div>

  {/* 마우스를 쓰는 환경에서만 의미가 있다. 숨김은 global.css 가 맡는다. */}
  <div id="cursor-toggle-row" class="app-layout flex justify-end pb-4">
    <button
      id="cursor-toggle"
      type="button"
      aria-pressed="false"
      class="text-muted-foreground hover:text-accent aria-pressed:text-accent group inline-flex items-center gap-2 text-xs"
    >
      <span
        class="group-aria-pressed:bg-current inline-block size-3 rounded-full border border-current"
      ></span>
      Glass cursor
    </button>
  </div>
</footer>
